PORT=3000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bd_farmacia
DB_USER=postgres
DB_PASSWORD=postgres
# Optional. Set to true if the database provider requires TLS.
DB_SSL=false
# Alternatively, provide DATABASE_URL instead of DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Set these before running `pnpm db:seed` to create the initial admin account.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
